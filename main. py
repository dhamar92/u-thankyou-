from kivy.app import App
from kivy.uix.boxlayout import BoxLayout
from kivy.uix.label import Label
from kivy.uix.textinput import TextInput
from kivy.uix.button import Button
from kivy.uix.scrollview import ScrollView
from kivy.uix.gridlayout import GridLayout
from kivy.metrics import dp
from kivy.core.window import Window
from kivy.graphics import Color, RoundedRectangle
import json, os

Window.clearcolor = (0.96, 0.96, 0.98, 1)
FILE = "utang.json"

class Card(BoxLayout):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        with self.canvas.before:
            Color(1, 1, 1, 1)
            self.rect = RoundedRectangle(radius=[dp(14)], pos=self.pos, size=self.size)
        self.bind(pos=self.update, size=self.update)
    def update(self, *args):
        self.rect.pos = self.pos
        self.rect.size = self.size

class UThankYouApp(App):
    def build(self):
        self.data = []
        if os.path.exists(FILE):
            with open(FILE, "r") as f:
                try: self.data = json.load(f)
                except: self.data = []
        # Biar data lama yang belum ada cicil tetap jalan
        for item in self.data:
            if "dibayar" not in item:
                item["dibayar"] = item["jumlah"] if item.get("lunas") else 0

        root = BoxLayout(orientation='vertical')

        header = BoxLayout(orientation='vertical', padding=dp(18), spacing=dp(2), size_hint_y=None, height=dp(110))
        with header.canvas.before:
            Color(1, 0.55, 0, 1)
            header.rect = RoundedRectangle(radius=[0, 0, dp(20), dp(20)], pos=header.pos, size=header.size)
        def update_header(instance, value):
            header.rect.pos = instance.pos
            header.rect.size = instance.size
        header.bind(pos=update_header, size=update_header)

        judul = Label(text='U-thankyou!', font_size=dp(24), bold=True, color=(1,1,1,1), size_hint_y=None, height=dp(30), halign='left', valign='middle')
        judul.bind(size=judul.setter('text_size'))
        sub = Label(text='Catet utang, bisa cicil juga!', font_size=dp(13), color=(1,1,1,1), size_hint_y=None, height=dp(18), halign='left', valign='middle')
        sub.bind(size=sub.setter('text_size'))
        self.total_label = Label(text='Total Utang: Rp 0', font_size=dp(19), bold=True, color=(1,1,1,1), size_hint_y=None, height=dp(28), halign='left', valign='middle')
        self.total_label.bind(size=self.total_label.setter('text_size'))
        header.add_widget(judul)
        header.add_widget(sub)
        header.add_widget(self.total_label)
        root.add_widget(header)

        body = BoxLayout(orientation='vertical', padding=dp(14), spacing=dp(10))

        form = Card(orientation='vertical', padding=dp(12), spacing=dp(8), size_hint_y=None, height=dp(215))
        self.nama = TextInput(hint_text='Utang ke siapa?', multiline=False, font_size=dp(15), size_hint_y=None, height=dp(46), background_color=(0.96,0.96,0.98,1))
        self.jumlah = TextInput(hint_text='Jumlah Rp', input_filter='int', multiline=False, font_size=dp(15), size_hint_y=None, height=dp(46), background_color=(0.96,0.96,0.98,1))
        self.ket = TextInput(hint_text='Buat apa?', multiline=False, font_size=dp(15), size_hint_y=None, height=dp(46), background_color=(0.96,0.96,0.98,1))
        form.add_widget(self.nama)
        form.add_widget(self.jumlah)
        form.add_widget(self.ket)
        body.add_widget(form)

        btn = Button(text='+ Tambah Utang', font_size=dp(16), bold=True, background_color=(1,0.55,0,1), size_hint_y=None, height=dp(50))
        btn.bind(on_press=self.tambah)
        body.add_widget(btn)

        body.add_widget(Label(text='Daftar Utang', font_size=dp(16), bold=True, color=(0,0,0,1), size_hint_y=None, height=dp(25), halign='left', valign='middle'))

        self.scroll = ScrollView()
        self.list_layout = GridLayout(cols=1, spacing=dp(10), size_hint_y=None)
        self.list_layout.bind(minimum_height=self.list_layout.setter('height'))
        self.scroll.add_widget(self.list_layout)
        body.add_widget(self.scroll)
        root.add_widget(body)
        self.refresh()
        return root

    def save(self):
        with open(FILE, "w") as f:
            json.dump(self.data, f)

    def tambah(self, x):
        if not self.nama.text or not self.jumlah.text:
            return
        self.data.append({"nama": self.nama.text, "jumlah": int(self.jumlah.text), "ket": self.ket.text, "lunas": False, "dibayar": 0})
        self.save()
        self.nama.text = ""; self.jumlah.text = ""; self.ket.text = ""
        self.refresh()

    def cicil(self, idx, input_widget):
        if not input_widget.text:
            return
        try:
            bayar = int(input_widget.text)
        except:
            return
        if bayar <= 0:
            return
        item = self.data[idx]
        dibayar = item.get("dibayar", 0)
        # Jangan sampai bayar lebih dari sisa
        sisa = item["jumlah"] - dibayar
        if bayar > sisa:
            bayar = sisa
        item["dibayar"] = dibayar + bayar
        if item["dibayar"] >= item["jumlah"]:
            item["lunas"] = True
        self.save()
        self.refresh()

    def refresh(self):
        self.list_layout.clear_widgets()
        total_sisa = 0
        if not self.data:
            self.list_layout.add_widget(Label(text='Belum ada utang. Aman!', font_size=dp(14), color=(0.6,0.6,0.6,1), size_hint_y=None, height=dp(50)))
        for i, item in enumerate(self.data):
            dibayar = item.get("dibayar", 0)
            sisa = item["jumlah"] - dibayar
            if not item["lunas"]:
                total_sisa += sisa
            status = "LUNAS" if item["lunas"] else "BELUM LUNAS"
            # Tinggi kartu dibikin lebih tinggi karena ada baris cicil
            card = Card(orientation='vertical', padding=dp(12), spacing=dp(4), size_hint_y=None, height=dp(185) if not item["lunas"] else dp(145))
            l1 = Label(text=f"{item['nama']} - Rp {item['jumlah']:,}".replace(",", "."), font_size=dp(16), bold=True, color=(0,0,0,1), size_hint_y=None, height=dp(24), halign='left', valign='middle')
            l1.bind(size=l1.setter('text_size'))
            l2 = Label(text=f"{item['ket']} | {status}", font_size=dp(13), color=(0.4,0.4,0.4,1), size_hint_y=None, height=dp(20), halign='left', valign='middle')
            l2.bind(size=l2.setter('text_size'))
            card.add_widget(l1)
            card.add_widget(l2)

            # BARIS CICIL - Info dibayar & sisa
            l_cicil = Label(text=f"Dibayar: Rp {dibayar:,}".replace(",", ".") + f"  |  Sisa: Rp {sisa:,}".replace(",", "."), font_size=dp(13), bold=True, color=(0.1,0.6,0.3,1) if not item["lunas"] else (0.1,0.7,0.3,1), size_hint_y=None, height=dp(20), halign='left', valign='middle')
            l_cicil.bind(size=l_cicil.setter('text_size'))
            card.add_widget(l_cicil)

            # BARIS INPUT CICIL - Cuma muncul kalau belum lunas
            if not item["lunas"]:
                row_cicil = BoxLayout(spacing=dp(8), size_hint_y=None, height=dp(40))
                inp = TextInput(hint_text='Cicil Rp...', input_filter='int', multiline=False, font_size=dp(13), size_hint_x=0.6, background_color=(0.96,0.96,0.98,1))
                b_cicil = Button(text='Cicil', font_size=dp(13), bold=True, background_color=(1,0.55,0,1), size_hint_x=0.4)
                # Simpan inputnya biar bisa dibaca pas tombol dipencet
                b_cicil.bind(on_press=lambda x, idx=i, w=inp: self.cicil(idx, w))
                row_cicil.add_widget(inp)
                row_cicil.add_widget(b_cicil)
                card.add_widget(row_cicil)

            row = BoxLayout(spacing=dp(8), size_hint_y=None, height=dp(38))
            if not item["lunas"]:
                b1 = Button(text='Lunasin Sekalian', font_size=dp(13))
                b1.bind(on_press=lambda x, idx=i: self.lunasi(idx))
                row.add_widget(b1)
            b2 = Button(text='Hapus', font_size=dp(13))
            b2.bind(on_press=lambda x, idx=i: self.hapus(idx))
            row.add_widget(b2)
            card.add_widget(row)
            self.list_layout.add_widget(card)
        self.total_label.text = f"Sisa Utang: Rp {total_sisa:,}".replace(",", ".")

    def lunasi(self, idx):
        self.data[idx]["dibayar"] = self.data[idx]["jumlah"]
        self.data[idx]["lunas"] = True
        self.save(); self.refresh()
    def hapus(self, idx):
        del self.data[idx]
        self.save(); self.refresh()

if __name__ == '__main__':
    UThankYouApp().run()
